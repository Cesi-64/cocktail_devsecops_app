# Copier en .env pour lancer l'API en local (npm run dev). Ne JAMAIS commiter le .env.
SERVER_PORT=12000

BDD_HOST=localhost
BDD_PORT=3306
BDD_NAME=cocktail
BDD_USER=cocktail
BDD_PASS=change-me

FIRST_ADMIN_PASSWORD=change-me
ALLOW_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUND=10

# Générer avec : openssl rand -base64 48
JWT_SECRET=change-me
JWT_DURING=1h
